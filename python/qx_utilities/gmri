def _call_summary(outcome):
    """
    What one call through `run_with_log` is reported as, in one line.

    The same spelling for the run's final report and for the status record a
    parent reads, so the two cannot drift: the error when the call raised, and
    the comlog to read when there is one.
    """
    return "%s%s" % (
        outcome.error
        or ("completed with errors" if outcome.failed else "completed"),
        " [log: %s]" % outcome.comlog if outcome.comlog else "",
    )


def _not_run(line, run):
    """
    A dry run of a matlab or bash call: says what it would run and runs
    nothing. 0, or 1 when there is nothing to run, which was said.
    """
    if line is None:
        return 1
    text = "\ntest, not run: %s\n" % line
    print(text)
    run.write(text)
    return 0


def _bash_sessions(qx_command, sessions, args):
    """
    The sessions a bash script is called once for, or `[None]` for one call
    with whatever session specification the run carries.

    A bash script is written for a single session -- of the thirteen routed
    here only `compute_bold_fc` and `run_qc` loop over a list of their own --
    and the shell front end called it once per session, in the loop at
    `bin/qunex.sh:1735` and its per command copies. The exception is a run that
    works *across* sessions: `bin/qunex.sh:2315` hands a group run the whole
    list in one call, and so does this.
    """
    if not sessions or args.get("runtype") in ["group", "list"]:
        return [None]

    if not (gcs.declared_parameters(qx_command) & {"session", "sessions"}):
        return [None]

    return [session["id"] for session in sessions]


def runCommand(command, args):
    """
    Runs `command` with `args`, and returns to the folder it was started from
    however it ends: a run that knows its study works in the study folder
    (`placement.work_in_study`), and a caller in the same process -- a test,
    a script importing gmri, the handlers of `main` -- must not be left there.
    """
    try:
        start = os.getcwd()
    except OSError:
        start = None

    try:
        return _run_command(command, args, start)
    finally:
        if start:
            try:
                os.chdir(start)
            except OSError:
                pass


def _run_command(command, args, start):
    timestamp = datetime.now().strftime(gf.TIMESTAMP)

    # --- check if command is deprecated
    if command != "check_deprecated_commands":
        command = gcs.check_deprecated_commands(command)

        # -- remap deprecated arguments
        args = gcs.check_deprecated_parameters(args, command)

    # -- what the command line names that is read before the study is known,
    #    made absolute: the study from the current folder, and the batch file,
    #    a `.list` of sessions and the recipe file from the study the command
    #    line -- or a `run_recipe` call's recipe, read here once -- names. One
    #    that names something only in the current folder is said before it is
    #    looked for
    typed = args
    args, recipe, recipe_named, early_study = gpl.anchor(command, args)
    # the warnings said before the runlog exists, for it once it does
    placement_notes = []
    gpl.warn_read_early(typed, early_study, start, placement_notes)

    # -- a first answer for the sessions folder `--sessions` are matched in,
    #    from the names in use: a deprecated `--basefolder` is a sessions
    #    folder. The header read below can still move it. The folders a
    #    recipe names stand in for a command line that names neither, so
    #    they fill only what it leaves unnamed
    folders = gc.deduce_folders({**args, **recipe_named})

    qx_command = qx_commands.get(command.strip())

    # -- is this a valid qunex command?
    if qx_command is None:
        print(f"ERROR: Command '{command}' not recognized. Please run qunex -l to see list of valid commands.")
        sys.exit(1)

    # -- which sessions, and the parameters the batch file's header states.
    #    Resolved here, for every command class, and above everything below:
    #    the header can name a different study, and the study is what the
    #    logging settings and the log folder are read from
    processing = qx_command.language == "python" and qx_command.type.startswith(
        "processing"
    )

    sessions, batch_header, unset_from_header = None, None, []
    if processing or "sessions" in args or "batchfile" in args:
        if folders["sessionsfolder"] is None:
            folders["sessionsfolder"] = "."

        # the folders the session records name are relative to each session's
        # folder, and the header read here can still move the sessions folder,
        # so they are resolved below, once that is settled
        sessions, batch_header = gc.resolve_sessions(
            batchfile=args.get("batchfile"),
            sessions=args.get("sessions"),
            filter=args.get("filter"),
            sessionsfolder=folders["sessionsfolder"],
            command=command,
            verbose=False,
            resolve_folders=False,
        )

        # what the run said not to take from the header, taken out here rather
        # than at the merge: the header places the run below as well, and a
        # parameter that is not to be taken is not to be taken for that either
        batch_header, unset_from_header = gpl.without_unset(
            batch_header, args, command
        )

    # -- sort arguments
    bargs = {}
    eargs = {}
    for k, v in args.items():
        if qx_command.has_arg(k):
            bargs[k] = v
        else:
            eargs[k] = v

    # -- what a python utility command will and will not accept. Checked before
    #    anything is logged: a call that is rejected leaves no log folder behind
    if qx_command.language == "python" and not processing and command != "run_recipe":
        bad = [k for k in eargs if k not in gcs.extra_parameters]
        for k in bad:
            print(f"ERROR: Extra argument {k} is not valid! Please check your command!")
        if bad:
            raise ge.CommandError(
                "gmri",
                "Invalid arguments",
                "Provided unknown arguments: [%s]!" % (", ".join(bad)),
            )

        # a batch file is not a request to run over its sessions -- it is also
        # where the header comes from, and every command takes that -- so only
        # a session list a command cannot act on is an error
        if "sessions" in eargs and not any(
            [qx_command.has_arg(e) for e in ["sourcefolder", "folder"]]
        ):
            raise ge.CommandError(
                "gmri",
                "Incompatible command",
                "Command %s can not be run on multiple sessions!" % (command),
            )

    # -- the one merged options dictionary every dispatcher below starts from
    options, sources, stated = gp.merge_options(command, args, batch_header)

    # -- and, for a python command, which is called with parameters rather than
    #    with the whole dictionary, the ones it declares that it was not given
    #    on the command line. Fill, never override: what the user typed reaches
    #    the command as the user typed it. Nothing is dropped here -- what a
    #    command cannot take, it was never passed before either.
    filled, _ = gcs.select_parameters(stated, sources, qx_command)
    filled = {key: value for key, value in filled.items() if key not in args}
    bargs = {**bargs, **filled}

    # -- the two folders as the merge settled them, absolute, for everything
    #    that is handed the command line from here on: a relative sessions
    #    folder is taken from a study any tier names. `filled` has them so
    #    already
    gpl.hand_on_folders(options, (args, bargs, eargs))

    # -- the threads the command may use. `bin/qunex.sh` sets this before it
    #    hands over, so a run started there arrives with it set and this
    #    changes nothing; the two are entry points to the same dispatcher and
    #    have to run a command the same way. Neither sets it for a dry run,
    #    which starts nothing that would read it
    gcs.set_omp_threads(options)

    # -- and the sessions' own folders, against the sessions folder the run
    #    works on. The merged options have it whichever tier named it, and
    #    whether it was named or taken to be the study's `sessions` folder
    if sessions:
        gf.resolve_sessions_folders(sessions, options["sessionsfolder"])

    # -- a processing run that names neither its study nor its sessions folder
    #    works in the current folder, as it always has. The sessions' own
    #    folders are resolved against it as well, so it is said rather than
    #    left for the run to find out
    if processing and sources.get("sessionsfolder") == "default":
        print(
            "WARNING: Neither --studyfolder nor --sessionsfolder was given, the "
            "current folder is taken to be the sessions folder [%s]."
            % options["sessionsfolder"],
            file=sys.stderr,
        )

    # -- where the run is, the folder it takes its relative paths from, where
    #    it logs and how, and whether, it is logged: decided here, once, in the
    #    folder it was started in, by the rule every entry point follows --
    #    from what was actually stated rather than from the merged options,
    #    whose `arglist` defaults would otherwise answer for folders nobody
    #    named. The header and a `run_recipe`'s recipe file may name the study
    placement = gpl.place_run(
        command, args, batch_header, timestamp, qx_command, recipe=recipe
    )

    # -- the run works in its study from here on -- its logging, its banner and
    #    the command, and every script and tool the command starts -- and says
    #    so when that is not where it was started
    moved, workfolder = gpl.work_in_study(
        command,
        placement,
        typed,
        start,
        scheduled="scheduler" in args,
        notes=placement_notes,
    )

    # the helpers at the bottom of `processing.core` hold no context; this is
    # the only way the answer reaches them
    log_settings = placement.settings
    gl.set_active(log_settings)

    # -- one runlog per run, shared by every call this invocation makes; built
    #    before any dispatch, so every path gets the same one. Everything the
    #    run starts -- a scheduler job, a recipe, a recipe step -- is handed
    #    this folder and logs in it as well, and a job starts where the run did
    run = gl.RunContext(
        command,
        args,
        log_settings,
        timestamp=timestamp,
        tag="long" if options.get("longitudinal") else None,
        name=placement.name,
        logfolder=placement.logfolder,
        startfolder=start,
    )

    # -- and a command that takes a log folder is handed the run's
    if not processing and qx_command.has_arg("logfolder"):
        bargs["logfolder"] = filled["logfolder"] = run.logfolder

    # -- the runlog header, and then what the command is about to be run with
    #    and where each of it came from. Before the dispatch, so a run that
    #    does something unexpected says why in its own first lines.
    #
    #    A command that writes no log writes no banner either: those are the
    #    commands whose stdout is read as data by a shell call site, and a
    #    banner in it would be read as a session list.
    #    `run_recipe` over no sessions is a dispatcher rather than a command:
    #    it builds its own run context and writes its own runlog, and a second
    #    one from here would only duplicate it
    recipe_runs_itself = (
        command == "run_recipe" and not sessions and "scheduler" not in args
    )

    if log_settings.enabled and not recipe_runs_itself:
        header = run.header()

        # the header reaches the console on the processing path alone, as it
        # did when `process.run` built the context and printed it there
        if processing:
            print(header)

        # on the console already, as they were said
        for note in placement_notes:
            run.write(note + "\n")

        # a processing command is handed the merged dictionary and reports it;
        # every other class is called with parameters, and reports those, so
        # that the banner and the call agree on how a value is spelled
        banner = gcs.report_parameters(
            qx_command, options if processing else {**options, **stated}, sources
        )

        # what an unset took out never enters the options, so the table above
        # reports what applied and this reports what did not. Named rather than
        # counted, because a pattern is not a list: `hcp_*` removes what this
        # study's header happens to state today
        banner += gcs.report_unset(unset_from_header, options)

        if moved:
            banner += "\n%srelative paths are taken from the study folder: %s\n" % (
                gl.INDENT,
                workfolder,
            )
        banner += "\n---> Logs: %s\n" % run.logfolder

        print(banner)
        run.write(banner)

    # -- a job reads the batch file header again where it starts, and is handed
    #    the study the run settled rather than reading a relative one from there
    if "scheduler" in args:
        args = gpl.for_jobs(command, args, options, placement)

    # -- is this a processing command?
    if processing:
        gp.run(qx_command, args, sessions, options, sources, run)
        return

    # -- is this a matlab or a bash command?
    if qx_command.language in ["matlab", "bash"]:
        cargs = {**args, **filled}

        if "scheduler" in args:
            # the job is submitted, not run: what it did is for the run on the
            # node to report in its runlog, and the status record, when one is
            # asked for, says what was submitted. A bash command is scheduled
            # per session, as `bin/qunex.sh` scheduled it (one submission
            # inside its per session loop)
            gs.run_through_scheduler(
                command,
                sessions=sessions if qx_command.language == "bash" else None,
                args=args,
                parsessions=int(args.get("parsessions", 1)),
                run=run,
            )
            return

        # a dry run names each call it would make and makes none: no script
        # and no matlab function reads --test, so handed on it ran for real.
        # The line is the one a real run makes, without the flag
        dry = options.get("run", "run") != "run"
        if dry:
            cargs = {k: v for k, v in cargs.items() if k not in ("test", "run")}

        if qx_command.language == "matlab":
            codes = [
                (command, _not_run(gm.command_line(qx_command, cargs)[0], run))
                if dry
                else (command, gm.run(qx_command, cargs, run=run))
            ]
        else:
            # a script run over the sessions of a batch file at once is handed
            # their ids: it cannot read the batch file they came from, which is
            # a run level parameter it is not passed
            if sessions and not ({"session", "sessions"} & set(cargs)):
                cargs[gb.session_parameter(qx_command)] = ",".join(
                    session["id"] for session in sessions
                )

            codes = [
                ("%s: %s" % (command, sid) if sid else command,
                 _not_run(gb.command_line(qx_command, cargs, session=sid), run)
                 if dry
                 else gb.run(qx_command, cargs, run=run, session=sid))
                for sid in _bash_sessions(qx_command, sessions, cargs)
            ]

        # the record a parent asked for. The exit code was the only thing
        # these paths reported and it reached the console alone, so a
        # matlab or bash step of a recipe had no status at all
        run.write_status(
            [
                (
                    name,
                    ("test, not run" if dry else "completed")
                    if not code
                    else "failed with exit code %s" % code,
                    1 if code else 0,
                )
                for name, code in codes
            ]
        )

        # and, as everywhere else, a command that failed fails the run.
        # `bin/qunex.sh` exited 1 for these (`qunex_failed`); this path
        # returned 0 whatever the script did
        if any(code for _, code in codes):
            raise ge.CommandFailed(
                command,
                "The command did not complete successfully",
                "Please check the logs in %s" % (run.logfolder),
            )
        return

    # -- any other (unsupported) language
    if qx_command.language != "python":
        print(f"ERROR: Commands in {qx_command.language} are not yet supported through gmri command line interface. Please see QuNex documentation for usage instructions.")
        sys.exit(1)

    # -- continue with regular python command

    # -- a command runs over the sessions only when the dispatcher has a way to
    #    hand it one: it either takes a session's folder, or it forwards the
    #    run's parameters on (`eargs`) and fans out itself. Everything else is
    #    called once, with the batch file's header filled in -- a command that
    #    declares `batchfile` resolves the sessions on its own
    if not any(qx_command.has_arg(e) for e in ["sourcefolder", "folder", "eargs"]):
        sessions = None

    calls = []

    # -- run_recipe specifics
    if command == "run_recipe":
        if sessions:
            # -- default is a recipe for each session
            parsessions = (int)(args.get("parsessions", 1))

            # all sessions
            all_sessions = []
            for session in sessions:
                if "id" in session:
                    all_sessions.append(session["id"])
                elif "session" in session:
                    all_sessions.append(session["session"])

            if "scheduler" in eargs:
                gs.run_through_scheduler(
                    command,
                    sessions=sessions,
                    args=args,
                    parsessions=parsessions,
                    run=run,
                )

            else:
                c = 0
                untouched_all_sessions = copy.deepcopy(all_sessions)
                while all_sessions:
                    c += 1
                    recipe_args = args.copy()

                    # set up a list of sessions to run in each run_recipe
                    slist = [
                        all_sessions.pop(0) for e in range(parsessions) if all_sessions
                    ]
                    recipe_args["sessions"] = ",".join(slist)

                    # pass all sessions if in slurm array
                    if "SLURM_ARRAY_TASK_ID" in os.environ:
                        recipe_args["sessions"] = (",").join(untouched_all_sessions)

                    # copy recipe args to eargs: what run_recipe does not take
                    # itself, it hands its steps
                    run_recipe_kwargs = [
                        name
                        for name in inspect.signature(
                            qx_command.load_callable()
                        ).parameters
                        if name not in ("eargs", "log_settings")
                    ]
                    recipe_eargs = {}
                    to_delete = []
                    for k, v in recipe_args.items():
                        if k not in run_recipe_kwargs:
                            recipe_eargs[k] = v
                            to_delete.append(k)

                    for arg in to_delete:
                        del recipe_args[arg]

                    recipe_args["eargs"] = recipe_eargs

                    # every recipe of one invocation logs into the run's
                    # folder, by the settings the run resolved for its study:
                    # the run was placed with the recipe file's tier already
                    recipe_args["log_settings"] = log_settings
                    recipe_args["logfolder"] = run.logfolder

                    # disable within recipe parallelism
                    recipe_eargs["parsessions"] = 1

                    calls.append(
                        {
                            "name": "run_recipe_%d" % (c),
                            "function": qx_command.load_callable(),
                            "args": recipe_args,
                        }
                    )

        else:
            # -- if using a scheduler schedule the whole run_recipe commmand
            if "scheduler" in eargs:
                gs.run_through_scheduler(command, args=args, run=run)

            else:
                bargs["eargs"] = eargs
                bargs["log_settings"] = log_settings
                qx_commands.get(command).load_callable()(**bargs)
                print(f"\n---> Successful completion of task at {datetime.now()}")

    # -- all other commands
    else:
        parsessions = int(eargs.get("parsessions", "1"))

        # -- are we using a scheduler
        if "scheduler" in eargs:
            gs.run_through_scheduler(
                command,
                sessions=sessions,
                args=args,
                parsessions=parsessions,
                run=run,
            )

        # -- a basic call
        elif sessions is None:
            cargs = {**args, **filled}

            # commands that are not logged run bare, without a comlog
            if not log_settings.enabled:
                # drop the run-level parameters the command itself does not take
                callable = qx_commands.get(command).load_callable()
                gc._drop_run_parameters(callable, cargs)
                # execute
                callable(**cargs)
            # run with log
            else:
                outcome = gc.run_with_log(
                    qx_commands.get(command).load_callable(),
                    args=cargs,
                    run=run,
                    tags=[command, args.get("sessions")],
                )

                # and, when a parent process asked for it, what this call did
                # as data. The sessions loop below and `gp.run` both write
                # theirs; a single utility call wrote none, so every utility
                # step of a recipe was reported as "no status reported" --
                # which is also what the step's caller has instead of an exit
                # code once the call is one of several in a recipe
                run.write_status([(command, _call_summary(outcome), outcome.failed)])

                # a failed command exits non-zero, the way the parallel path
                # below already does: `bin/qunex.sh` returns gmri's status
                # verbatim, so this is how a shell, a scheduler job or CI
                # learns the command did not do what it was asked
                if outcome.failed:
                    raise ge.CommandFailed(
                        command,
                        "The command did not complete successfully",
                        "Please check the log in %s"
                        % (outcome.comlog or run.logfolder),
                    )

        # -- sessions loop
        else:
            for session in sessions:
                targs = dict(bargs)
                name = command + ": " + session["id"]
                # the session's folder, in the sessions folder the run works
                # on -- the merged one, which every tier and the study's own
                # `sessions` folder have had their say on
                sessionfolder = os.path.join(options["sessionsfolder"], session["id"])
                for targ in ["sourcefolder", "folder"]:
                    if qx_command.has_arg(targ):
                        targs[targ] = sessionfolder

                calls.append(
                    {
                        "name": name,
                        "function": qx_command.load_callable(),
                        "args": targs,
                        "tags": [command, session["id"]],
                    }
                )

    # -- Have we set up calls to run in parallel?
    if calls:

        callInfo = "Running %s" % (command)
        callInfo += "\n" + "".join(["=" for e in range(len(callInfo))])
        print(callInfo)

        print(
            "\n---> Running %s through %d sessions in parallel" % (command, parsessions)
        )

        results = gc.run_in_parallel(
            calls, cores=parsessions, prepend="     ... ", run=run
        )

        # the same digest a processing command produces, from the same method:
        # the results are adapted to the (id, summary, failed) contract, with
        # the comlog path folded into the summary. `failed` comes from
        # run_with_log, which counts a recorded error as well as a raise; this
        # path is deleted when utility commands that run over sessions become
        # processing commands and go through `gp.run`.
        stati = [
            (outcome.name, _call_summary(outcome), outcome.failed)
            for outcome in sorted(results, key=lambda outcome: outcome.name)
        ]
        run.final_report(stati)
        run.write_status(stati)

        # `failed is None` is a call that did not complete -- a worker that
        # died -- and it fails the run as squarely as a call that reported a
        # failure does
        if any(failed is None or failed for _, _, failed in stati):
            raise ge.CommandFailed(
                command,
                "Not all tasks completed fully",
                "Please check the logs in %s" % (run.logfolder),
            )


def print_bash_help(cmd):
    # Print the command's usage() heredoc, i.e. the exact text the author wrote
    # (this is the same text the registry parsed the doc from). Mirrors the
    # python path, which prints the raw docstring.
    qunexpath = os.environ.get("QUNEXPATH", "").strip()
    script = Path(qunexpath) / "bash" / cmd.path if qunexpath else Path(cmd.path)
    doc = None
    try:
        from qx_registry_build import _bash_usage_heredoc
        doc = _bash_usage_heredoc(script.read_text(encoding="utf-8"))
    except Exception:
        doc = None

    if doc:
        print("\nqunex", doc.strip(), "\n")
        return

    # fallback: reconstruct from the registry fields
    print(f"\nqunex {cmd.call or cmd.name}\n")
    if cmd.description:
        print(f"{cmd.description}\n")
    for o in cmd.options:
        print(f"  --{o.name}: {o.description or ''}")
    print()


def print_help(com):

    # --- print list of available commands, required for qunex.sh checks
    if com == "available":
        available_commands = qx_commands.gmri_commands()        
        print(" ".join(available_commands))

    # --- print all commands
    elif com in ["a", "all", "allcommands"]:
        for name, path, description, _ in qx_commands.to_qunex_list():
            print(f"- {name}: {description}")

    else: 
        cmd = qx_commands.get(com)
        # --- print help for python commands
        if cmd and cmd.language == "python":
            print("\nqunex", qx_commands.load_callable(com).__doc__.strip(), "\n")

        # --- print help for matlab functions
        elif cmd and cmd.language == "matlab":
            gm.help(com)

        # --- print help for bash commands
        elif cmd and cmd.language == "bash":
            print_bash_help(cmd)

        # --- `gmri log_folder`, which `bin/qunex.sh` calls; not a registered
        #     command, so its usage is the docstring of what answers it
        elif com == "log_folder":
            print("\n" + inspect.cleandoc(gpl.print_log_folder.__doc__) + "\n")

        else:
            print(f"\nERROR: Requested command ('{com}') is not supported. Refer to general QuNex usage.\n")


def main(args=None):

    if args is None:
        args = sys.argv[1:]

    oargs = copy.deepcopy(args)

    if len(args) == 0:
        print(help)
        sys.exit(0)

    comm = args[0].strip("-")
    opts = dict()

    try:
        # the two generated files are rebuilt by name, here rather than through
        # `runCommand`, because `build_qx_registry` has to run when there is no
        # registry to look a command up in. A bare `qunex <command>` is read as
        # a request for help below, so both are dispatched here -- unless help
        # is what was asked for, which still falls through
        wants_help = any(a.strip("-") in ["h", "H", "help"] for a in args[1:])

        if comm in ('build_qx_registry', 'build_qx_extensions') and not wants_help:
            from qx_registry_build import build_qx_extensions, build_qx_registry

            # both build a registry before there is one to look a command up in,
            # so both come through here. `build_qx_extensions` is the one an
            # extension author is given -- it leaves the installation's own
            # registry alone, which inside a container it could not write anyway
            builder = build_qx_registry if comm == 'build_qx_registry' else build_qx_extensions
            if comm == 'build_qx_registry':
                print("Building command registry...")

            # the bypass above used to drop the call's options with it, so
            # `--build_core=no` was accepted and then quietly ignored. They are
            # read here instead, and checked against what the command takes:
            # the check `runCommand` does for a utility command is not reached
            # on this path either
            for arg in args[1:]:
                if "=" in arg:
                    key, value = arg.split("=", 1)
                    opts[key.strip("-")] = value

            unknown = [
                key
                for key in opts
                if key not in inspect.signature(builder).parameters
            ]
            if unknown:
                raise ge.CommandError(
                    comm,
                    "Invalid arguments",
                    "Provided unknown arguments: [%s]!" % (", ".join(unknown)),
                )

            builder(**opts)
            if comm == 'build_qx_registry':
                print("Command registry successfully built!")
            sys.exit(0)

        if comm == 'build_qx_container' and not wants_help:
            from qx_container_build import build_qx_container
            build_qx_container()
            sys.exit(0)

        # where a run would log, for `bin/qunex.sh`; not a registered command,
        # see `placement.print_log_folder`
        if comm == 'log_folder' and not wants_help:
            for arg in args[1:]:
                key, sep, value = arg.partition("=")
                opts[key.strip("-")] = value if sep else True
            gpl.print_log_folder(opts)
            sys.exit(0)

        help_request = False
        if comm in ["a", "A", "allcommands", "available"]:
            help_request = True
        else:
            if len(args) == 1:
                help_request = True
            else:
                for n in range(1, len(args)):
                    # if h, H or -help flag is provided user is looking for help
                    if args[n].strip("-") in ["h", "H", "help"]:
                        help_request = True
                        break
                    elif "=" in args[n]:
                        k, v = args[n].split("=", 1)
                        k = k.strip("-")
                        opts[k] = v
                    else:
                        k = args[n].strip("-")
                        opts[k] = True

        # print help or run the command
        if help_request:
            try:
                comm = gcs.check_deprecated_commands(comm)
                print_help(comm)
            except:
                print(f"ERROR: '{comm}' is not a recognized command!\n-----------------------")
                print(help)
                raise
        else:
            runCommand(comm, opts)

    # A parent that asked for a status record gets one however this ends. The
    # run writes its own when it gets far enough to build one, and this fills
    # in for the runs that do not: a command that raised before its loop, a
    # worker that never came back, a name that is not a command. Without it
    # `run_recipe` reported such a step as "no status reported" -- the step
    # that failed hardest being the one it could say least about. A record
    # already written is kept: `write_failure_status` no-ops after one.
    except ge.CommandNull as e:
        # nothing to do is not a failure, and the record says so
        gl.write_failure_status(opts, comm, e, failed=0)
        print(ge.report_command_null(comm, e))
        print()
        sys.exit(0)
    except ge.CommandFailed as e:
        gl.write_failure_status(opts, comm, e)
        print(ge.report_command_failed(comm, e))
        print()
        sys.exit(1)
    except ge.CommandError as e:
        gl.write_failure_status(opts, comm, e)
        print(ge.report_command_error(comm, e))
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        print(
            "\nPlease run `qunex %s --help` to get help for the failed command.\n"
            % (comm)
        )
        sys.exit(1)
    except ValueError as e:
        gl.write_failure_status(opts, comm, e)
        print(
            "\n--------------------------------- QuNex failed ---------------------------------\nERROR: Execution of qunex command %s failed!"
            % (comm)
        )
        print(e)
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        raise
    except SystemExit as e:
        # the paths that exit rather than raise -- an unrecognised command, an
        # unsupported language -- and which a recipe reaches by way of a typo
        if e.code:
            gl.write_failure_status(opts, comm, "exited with status %s" % e.code)
        sys.exit(e)
    except:
        # the clause stays bare: it is what keeps a KeyboardInterrupt from
        # being swallowed here, so the exception is read rather than bound
        gl.write_failure_status(opts, comm, sys.exc_info()[1])
        print(
            "\n--------------------------------- QuNex failed ---------------------------------\n\nERROR: Execution of command `%s` failed!"
            % (comm)
        )
        print(
            "       Please check documentation for the command (`qunex %s --help`)!"
            % (comm)
        )
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        print(
            "\n--------------------------------------------------------------\nHere's the error as caught by python:\n"
        )
        raise


if __name__ == "__main__":
    main()
