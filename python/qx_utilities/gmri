help = r"""DESCRIPTION: QuNex suite python-based general neuroimaging utilities
(qx_utilities) commands can be invoked via the "qunex <command>" call.

 General QuNex usage syntax
============================

 qunex <command_name>
  --parameterA=<required-parameter-args>
  [--parameterB=<optional-parameter-args>]

  =>  --   Dashes or “flags” denote input parameters.
  =>  []   Square brackets denote optional parameters.
           Note: Arguments shown inside [] denote default behavior of optional parameters.
  =>  <>   Angle brackets denote user-specified arguments for a given parameter.
  => Command names, parameters and arguments are shown in small or “camel” case.

 Specific command usage
=======================

  qunex <command_name> --h


 Display a list of all QuNex commands
======================================

  qunex --a
"""


def _call_summary(outcome):
    """
    What one call through `run_with_log` is reported as, in one line.

    The same spelling for the run's final report and for the status record a
    parent reads, so the two cannot drift: the error when the call raised, and
    the comlog to read when there is one.
    """
    return "%s%s" % (
        outcome.error
        or ("completed with errors" if outcome.failed else "completed"),
        " [log: %s]" % outcome.comlog if outcome.comlog else "",
    )


def runCommand(command, args):
    timestamp = datetime.now().strftime("%Y-%m-%d_%H.%M.%S.%f")

    folders = gc.deduce_folders(args, command, timestamp)

    # --- check if command is deprecated
    if command != "check_deprecated_commands":
        command = gcs.check_deprecated_commands(command)

        # -- remap deprecated arguments
        args = gcs.check_deprecated_parameters(args, command)

    qx_command = qx_commands.get(command.strip())

    # -- is this a valid qunex command?
    if qx_command is None:
        print(f"ERROR: Command '{command}' not recognized. Please run qunex -l to see list of valid commands.")
        sys.exit(1)

    # -- how, and whether, this run is logged
    log_settings = gl.resolve_logging(
        command,
        args,
        qx_command=qx_command,
        studyfolder=folders["basefolder"],
        legacy_skip=gcs.logskip_commands,
    )

    # the helpers at the bottom of `processing.core` hold no context; this is
    # the only way the answer reaches them
    gl.set_active(log_settings)

    # -- is this a processing command?
    if qx_command.language == "python" and qx_command.type.startswith("processing"):
        # process.run builds its own RunContext: it merges the batch file into
        # the options first, and that can move the study (and so the log)
        # folder. The settings resolved above are what it builds it from.
        gp.run(qx_command, args, log_settings)
        return

    # -- one runlog per run, shared by every call this invocation makes; built
    #    before any dispatch, so the matlab, bash and scheduler paths get it too
    run = gl.RunContext(command, args, log_settings, folders, timestamp=timestamp)

    # -- is this a matlab or a bash command?
    if qx_command.language in ["matlab", "bash"]:
        run.header()
        if "scheduler" in args:
            # the job is submitted, not run: what it did is for the run on the
            # node to report, so there is no record to write here
            gs.run_through_scheduler(command, sessions=None, args=args, run=run)
        else:
            if qx_command.language == "matlab":
                code = gm.run(qx_command, args, run=run)
            else:
                code = gb.run(qx_command, args, run=run)

            # the record a parent asked for. The exit code was the only thing
            # these paths reported and it reached the console alone, so a
            # matlab or bash step of a recipe had no status at all
            run.write_status(
                [
                    (
                        command,
                        "completed" if not code else "failed with exit code %s" % code,
                        1 if code else 0,
                    )
                ]
            )
        return

    # -- any other (unsupported) language
    if qx_command.language != "python":
        print(f"ERROR: Commands in {qx_command.language} are not yet supported through gmri command line interface. Please see QuNex documentation for usage instructions.")
        sys.exit(1)

    # -- continue with regular python command
    
    # -- sort arguments
    bargs = {}
    eargs = {}
    for k, v in args.items():
        if qx_command.has_arg(k):
            bargs[k] = v
        else:
            eargs[k] = v

    # -- check extra arguments, except for run_recipe
    if eargs and command != "run_recipe":
        bad = []
        for k, v in eargs.items():
            if k not in gcs.extra_parameters:
                bad.append(k)
                print(f"ERROR: Extra argument {k} is not valid! Please check your command!")
        if bad:
            raise ge.CommandError(
                "gmri",
                "Invalid arguments",
                "Provided unknown arguments: [%s]!" % (", ".join(bad)),
            )

    # -- process extra arguments
    sessions = None
    if "sessions" in eargs:
        if command != "run_recipe" and not any(
            [qx_command.has_arg(e) for e in ["sourcefolder", "folder"]]
        ):
            raise ge.CommandError(
                "gmri",
                "Incompatible command",
                "Command %s can not be run on multiple sessions!" % (command),
            )
        if folders["sessionsfolder"] is None:
            folders["sessionsfolder"] = "."

        sessions_param = eargs["sessions"]
        sessions, _ = gc.get_sessions_list(
            sessions_param,
            filter=eargs.get("filter"),
            sessionids=eargs.get("sessionids"),
            sessionsfolder=folders["sessionsfolder"],
            verbose=False,
        )

    calls = []

    # -- run_recipe specifics
    if command == "run_recipe":
        if sessions:
            # -- default is a recipe for each session
            parsessions = (int)(args.get("parsessions", 1))

            # all sessions
            all_sessions = []
            for session in sessions:
                if "id" in session:
                    all_sessions.append(session["id"])
                elif "session" in session:
                    all_sessions.append(session["session"])

            if "scheduler" in eargs:
                run.header()
                gs.run_through_scheduler(
                    command,
                    sessions=sessions,
                    args=args,
                    parsessions=parsessions,
                    run=run,
                )

            else:
                c = 0
                untouched_all_sessions = copy.deepcopy(all_sessions)
                while all_sessions:
                    c += 1
                    recipe_args = args.copy()

                    # set up a list of sessions to run in each run_recipe
                    slist = [
                        all_sessions.pop(0) for e in range(parsessions) if all_sessions
                    ]
                    recipe_args["sessionids"] = ",".join(slist)

                    # pass all sessions if in slurm array
                    if "SLURM_ARRAY_TASK_ID" in os.environ:
                        recipe_args["sessionids"] = (",").join(untouched_all_sessions)

                    # copy recipe args to eargs
                    run_recipe_kwargs = [
                        "recipe_file",
                        "recipe",
                        "steps",
                        "startwith",
                        "xnat",
                        "logfolder",
                        "verbose",
                    ]
                    recipe_eargs = {}
                    to_delete = []
                    for k, v in recipe_args.items():
                        if k not in run_recipe_kwargs:
                            recipe_eargs[k] = v
                            to_delete.append(k)

                    for arg in to_delete:
                        del recipe_args[arg]

                    recipe_args["eargs"] = recipe_eargs

                    # the recipe builds its own RunContext from these -- the
                    # recipe file can move the study -- but every parallel
                    # recipe of one invocation logs into one folder
                    recipe_args["log_settings"] = log_settings
                    if not recipe_args.get("logfolder"):
                        recipe_args["logfolder"] = run.logfolder

                    # disable within recipe parallelism
                    recipe_eargs["parsessions"] = 1

                    calls.append(
                        {
                            "name": "run_recipe_%d" % (c),
                            "function": qx_command.load_callable(),
                            "args": recipe_args,
                        }
                    )

        else:
            # -- if using a scheduler schedule the whole run_recipe commmand
            if "scheduler" in eargs:
                run.header()
                gs.run_through_scheduler(command, args=args, run=run)

            else:
                bargs["eargs"] = eargs
                bargs["log_settings"] = log_settings
                qx_commands.get(command).load_callable()(**bargs)
                print(f"\n---> Successful completion of task at {datetime.now()}")

    # -- all other commands
    else:
        parsessions = int(eargs.get("parsessions", "1"))

        # if we have sessions and sessionids filter and remove one
        if "sessions" in args and "sessionids" in args:
            args_filter = None
            if "filter" in args:
                args_filter = args["filter"]

            sessions_dict, _ = gc.get_sessions_list(
                args["sessions"],
                filter=args_filter,
                sessionids=args["sessionids"],
                verbose=False,
            )

            sessions_list = []
            for session in sessions_dict:
                if "id" in session:
                    sessions_list.append(session["id"])
                elif "session" in session:
                    sessions_list.append(session["session"])

            # store the batchfile
            if ".txt" in args["sessions"]:
                args["batchfile"] = args["sessions"]
            args["sessions"] = ",".join(sessions_list)

            del args["sessionids"]

        # -- are we using a scheduler
        if "scheduler" in eargs:
            run.header()
            gs.run_through_scheduler(
                command,
                sessions=sessions,
                args=args,
                parsessions=parsessions,
                run=run,
            )

        # -- a basic call
        elif sessions is None:
            # commands that are not logged run bare, without a comlog
            if not log_settings.enabled:
                # drop the run-level parameters the command itself does not take
                callable = qx_commands.get(command).load_callable()
                gc._drop_run_parameters(callable, args)
                # execute
                callable(**args)
            # run with log
            else:
                run.header()
                outcome = gc.run_with_log(
                    qx_commands.get(command).load_callable(),
                    args=args,
                    run=run,
                    tags=[command, args.get("sessionids")],
                )

                # and, when a parent process asked for it, what this call did
                # as data. The sessions loop below and `gp.run` both write
                # theirs; a single utility call wrote none, so every utility
                # step of a recipe was reported as "no status reported" --
                # which is also what the step's caller has instead of an exit
                # code once the call is one of several in a recipe
                run.write_status([(command, _call_summary(outcome), outcome.failed)])

                # a failed command exits non-zero, the way the parallel path
                # below already does: `bin/qunex.sh` returns gmri's status
                # verbatim, so this is how a shell, a scheduler job or CI
                # learns the command did not do what it was asked
                if outcome.failed:
                    raise ge.CommandFailed(
                        command,
                        "The command did not complete successfully",
                        "Please check the log in %s"
                        % (outcome.comlog or run.logfolder),
                    )

        # -- sessions loop
        else:
            for session in sessions:
                targs = dict(bargs)
                name = command + ": " + session["id"]
                sessionsfolder = os.path.join(folders["sessionsfolder"], session["id"])
                for targ in ["sourcefolder", "folder"]:
                    if qx_command.has_arg(targ):
                        targs[targ] = sessionsfolder

                calls.append(
                    {
                        "name": name,
                        "function": qx_command.load_callable(),
                        "args": targs,
                        "tags": [command, session["id"]],
                    }
                )

    # -- Have we set up calls to run in parallel?
    if calls:
        run.header()

        callInfo = "Running %s" % (command)
        callInfo += "\n" + "".join(["=" for e in range(len(callInfo))])
        print(callInfo)

        print(
            "\n---> Running %s through %d sessions in parallel" % (command, parsessions)
        )

        results = gc.run_in_parallel(
            calls, cores=parsessions, prepend="     ... ", run=run
        )

        # the same digest a processing command produces, from the same method:
        # the results are adapted to the (id, summary, failed) contract, with
        # the comlog path folded into the summary. `failed` comes from
        # run_with_log, which counts a recorded error as well as a raise; this
        # path is deleted when utility commands that run over sessions become
        # processing commands and go through `gp.run`.
        stati = [
            (outcome.name, _call_summary(outcome), outcome.failed)
            for outcome in sorted(results, key=lambda outcome: outcome.name)
        ]
        run.final_report(stati)
        run.write_status(stati)

        # `failed is None` is a call that did not complete -- a worker that
        # died -- and it fails the run as squarely as a call that reported a
        # failure does
        if any(failed is None or failed for _, _, failed in stati):
            raise ge.CommandFailed(
                command,
                "Not all tasks completed fully",
                "Please check the logs in %s" % (run.logfolder),
            )


def print_bash_help(cmd):
    # Print the command's usage() heredoc, i.e. the exact text the author wrote
    # (this is the same text the registry parsed the doc from). Mirrors the
    # python path, which prints the raw docstring.
    qunexpath = os.environ.get("QUNEXPATH", "").strip()
    script = Path(qunexpath) / "bash" / cmd.path if qunexpath else Path(cmd.path)
    doc = None
    try:
        from qx_registry_build import _bash_usage_heredoc
        doc = _bash_usage_heredoc(script.read_text(encoding="utf-8"))
    except Exception:
        doc = None

    if doc:
        print("\nqunex", doc.strip(), "\n")
        return

    # fallback: reconstruct from the registry fields
    print(f"\nqunex {cmd.call or cmd.name}\n")
    if cmd.description:
        print(f"{cmd.description}\n")
    for o in cmd.options:
        print(f"  --{o.name}: {o.description or ''}")
    print()


def print_help(com):

    # --- print list of available commands, required for qunex.sh checks
    if com == "available":
        available_commands = qx_commands.gmri_commands()        
        print(" ".join(available_commands))

    # --- print all commands
    elif com in ["a", "all", "allcommands"]:
        for name, path, description, _ in qx_commands.to_qunex_list():
            print(f"- {name}: {description}")

    else: 
        cmd = qx_commands.get(com)
        # --- print help for python commands
        if cmd and cmd.language == "python":
            print("\nqunex", qx_commands.load_callable(com).__doc__.strip(), "\n")

        # --- print help for matlab functions
        elif cmd and cmd.language == "matlab":
            gm.help(com)

        # --- print help for bash commands
        elif cmd and cmd.language == "bash":
            print_bash_help(cmd)

        else:
            print(f"\nERROR: Requested command ('{com}') is not supported. Refer to general QuNex usage.\n")


def main(args=None):

    if args is None:
        args = sys.argv[1:]

    oargs = copy.deepcopy(args)

    if len(args) == 0:
        print(help)
        sys.exit(0)

    comm = args[0].strip("-")
    opts = dict()

    try:
        if comm == 'build_qx_registry':
            print("Building command registry...")
            from qx_registry_build import build_qx_registry
            build_qx_registry()
            print("Command registry successfully built!")
            sys.exit(0)      

        help_request = False
        if comm in ["a", "A", "allcommands", "available"]:
            help_request = True
        else:
            if len(args) == 1:
                help_request = True
            else:
                for n in range(1, len(args)):
                    # if h, H or -help flag is provided user is looking for help
                    if args[n].strip("-") in ["h", "H", "help"]:
                        help_request = True
                        break
                    elif "=" in args[n]:
                        k, v = args[n].split("=", 1)
                        k = k.strip("-")
                        opts[k] = v
                    else:
                        k = args[n].strip("-")
                        opts[k] = True

        # print help or run the command
        if help_request:
            try:
                comm = gcs.check_deprecated_commands(comm)
                print_help(comm)
            except:
                print(f"ERROR: '{comm}' is not a recognized command!\n-----------------------")
                print(help)
                raise
        else:
            runCommand(comm, opts)

    # A parent that asked for a status record gets one however this ends. The
    # run writes its own when it gets far enough to build one, and this fills
    # in for the runs that do not: a command that raised before its loop, a
    # worker that never came back, a name that is not a command. Without it
    # `run_recipe` reported such a step as "no status reported" -- the step
    # that failed hardest being the one it could say least about. A record
    # already written is kept: `write_failure_status` no-ops after one.
    except ge.CommandNull as e:
        # nothing to do is not a failure, and the record says so
        gl.write_failure_status(opts, comm, e, failed=0)
        print(ge.report_command_null(comm, e))
        print()
        sys.exit(0)
    except ge.CommandFailed as e:
        gl.write_failure_status(opts, comm, e)
        print(ge.report_command_failed(comm, e))
        print()
        sys.exit(1)
    except ge.CommandError as e:
        gl.write_failure_status(opts, comm, e)
        print(ge.report_command_error(comm, e))
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        print(
            "\nPlease run `qunex %s --help` to get help for the failed command.\n"
            % (comm)
        )
        sys.exit(1)
    except ValueError as e:
        gl.write_failure_status(opts, comm, e)
        print(
            "\n--------------------------------- QuNex failed ---------------------------------\nERROR: Execution of qunex command %s failed!"
            % (comm)
        )
        print(e)
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        raise
    except SystemExit as e:
        # the paths that exit rather than raise -- an unrecognised command, an
        # unsupported language -- and which a recipe reaches by way of a typo
        if e.code:
            gl.write_failure_status(opts, comm, "exited with status %s" % e.code)
        sys.exit(e)
    except:
        # the clause stays bare: it is what keeps a KeyboardInterrupt from
        # being swallowed here, so the exception is read rather than bound
        gl.write_failure_status(opts, comm, sys.exc_info()[1])
        print(
            "\n--------------------------------- QuNex failed ---------------------------------\n\nERROR: Execution of command `%s` failed!"
            % (comm)
        )
        print(
            "       Please check documentation for the command (`qunex %s --help`)!"
            % (comm)
        )
        print(
            "\nThe call received was: \n(please note that when run through scheduler, all possible parameters, \neven non relevant ones are passed) \n\nqunex %s "
            % (" \\\n    ".join(oargs))
        )
        print(
            "\n--------------------------------------------------------------\nHere's the error as caught by python:\n"
        )
        raise


if __name__ == "__main__":
    main()
