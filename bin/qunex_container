# a deprecated name, in lower case, and the name it has now
_CURRENT_COMMANDS = {
    old.lower(): new for new, olds in DEPRECATED_COMMANDS.items() for old in olds
}


# where a run that names no study looks for the one it is in, in this order,
# before it looks at the current folder
STUDY_HINTS = ("logfolder", "sourcefolder", "folder", "reference")

# every parameter that places a run
PLACEMENT_PARAMETERS = ("studyfolder", "sessionsfolder") + STUDY_HINTS

# how a recipe says that a parameter is not to be inherited
UNSET_PARAMETERS = "unset_parameters"

# a `{{$NAME}}` label in a recipe file, found as `run_recipe` finds it: from
# `{{` to the first `}}` after it, across a line break as well
_LABEL = re.compile(r"\{\{.*?\}\}", re.S)

# what `run_folders` returns: the name the run is filed under; its study, and
# whether the study is known (named, rather than found by its marker); the
# folder it takes its relative paths from, None for the current folder; its
# log folder; and the settings the `settings` callable returned for the study
Placement = namedtuple("Placement", "name studyfolder known base logfolder settings")

# the two settings that place a run's logs
LogPlacement = namedtuple("LogPlacement", "layout outside_study")


class PlacementError(ValueError):
    """A run that can not be placed: an unset label, or an invalid setting."""


def current_command(command):
    """
    ``current_command(command)``

    The name `command` has now: a deprecated name of a QuNex command, in any
    case, is the name it was renamed to (``DEPRECATED_COMMANDS``), as
    ``commands_support.check_deprecated_commands`` maps it; any other is
    returned as it is.
    """
    if not isinstance(command, str):
        return command
    return _CURRENT_COMMANDS.get(command.lower(), command)


def run_name(command, args=None):
    """
    ``run_name(command, args=None)``

    The name a run's log folder and runlog are filed under: the command, by
    the name it has now (:func:`current_command`), and for ``run_recipe`` the
    recipe as well -- ``run_recipe_<recipe>``, a path separator in the
    recipe's name read as ``_``, or ``run_recipe_steps`` for a run of
    ``--steps`` without a recipe file.
    """
    command = current_command(command)
    if command != "run_recipe":
        return command

    args = args or {}
    if not args.get("recipe_file"):
        return "run_recipe_steps"
    if args.get("recipe"):
        return "run_recipe_%s" % str(args["recipe"]).replace(os.sep, "_")
    return command


def recipe_parameters(recipe_data, recipe):
    """
    ``recipe_parameters(recipe_data, recipe)``

    The parameters a parsed recipe file states for every step of ``recipe``:
    its ``global_parameters``, overridden by the recipe's own ``parameters``,
    less the ones the recipe unsets. Labels are left as they are written. An
    empty dict when the file holds no such recipe, and a section that is not a
    mapping states nothing -- `run_recipe` reports both, and validates how an
    unset is spelled.
    """
    recipes = recipe_data.get("recipes") if isinstance(recipe_data, dict) else None
    if not isinstance(recipes, dict) or not isinstance(recipes.get(recipe), dict):
        return {}

    parameters = recipe_data.get("global_parameters")
    parameters = dict(parameters) if isinstance(parameters, dict) else {}
    own = recipes[recipe].get("parameters")
    own = dict(own) if isinstance(own, dict) else {}

    stated = own.pop(UNSET_PARAMETERS, None)
    if isinstance(stated, str):
        unset = stated.split(",")
    elif isinstance(stated, (list, tuple)):
        unset = [str(name) for name in stated]
    else:
        unset = []
    for key in [key for key in own if isinstance(key, str) and key.startswith("-")]:
        own.pop(key)
        unset.append(key[1:])

    parameters.update(own)
    for name in unset:
        parameters.pop(name.strip(), None)
    return parameters


def inject_labels(value, environ=None):
    """
    ``inject_labels(value, environ=None)``

    ``value`` with every ``{{$NAME}}`` label of a recipe file replaced by
    ``NAME`` from ``environ``, the environment unless another is given.
    Anything that is not a string holding a label is returned as it is.
    Raises PlacementError on a label ``environ`` does not hold: a recipe can
    not be run half resolved.
    """
    if not isinstance(value, str) or "{{" not in value or "}}" not in value:
        return value

    environ = os.environ if environ is None else environ
    for label in _LABEL.findall(value):
        name = label.replace("{", "").replace("}", "")
        if not name.startswith("$") or name[1:] not in environ:
            raise PlacementError(
                "Cannot inject values marked with double curly braces in the "
                "recipe. Label [%s] not found in system environment variables." % label
            )
        value = value.replace(label, environ[name[1:]])
    return value


def _canonical(parameters):
    """
    `parameters` under the names they have now, remapped as
    `commands_support.check_deprecated_parameters` remaps them: a later key
    wins over an earlier one, and a deprecated name with no value is dropped
    rather than taking the place of the name it has now.
    """
    canonical = {}
    for key, value in (parameters or {}).items():
        if key in FOLDER_ALIASES:
            if not value:
                continue
            key = FOLDER_ALIASES[key]
        canonical[key] = value
    return canonical


def recipe_placement(recipe_data, recipe, environ=None):
    """
    ``recipe_placement(recipe_data, recipe, environ=None)``

    The recipe file's tier of the parameters that place a `run_recipe` run:
    those of :func:`recipe_parameters` that are among `PLACEMENT_PARAMETERS`,
    under the names they have now, with their labels injected from
    ``environ`` -- the environment unless another is given. QuNex and the
    container launcher read the tier with it; the launcher on the host may
    not hold every variable the run will.

    Returns:
        ``(parameters, unresolved)``: the parameters, and a ``(name, message)``
        pair for each one with a label ``environ`` does not hold. Such a
        parameter is left out rather than raised on, so that the caller can
        say so and place the run by the other tiers.
    """
    parameters, unresolved = {}, []
    for key, value in _canonical(recipe_parameters(recipe_data, recipe)).items():
        if key not in PLACEMENT_PARAMETERS:
            continue
        try:
            parameters[key] = inject_labels(value, environ)
        except PlacementError as e:
            unresolved.append((key, str(e)))
    return parameters, unresolved


def placement_parameters(*tiers):
    """
    ``placement_parameters(*tiers)``

    The parameters that place a run, each from the first tier that states it.
    The tiers are given highest first -- the command line, the recipe file of
    a `run_recipe` run, the batch file header -- and a deprecated name counts
    as the name it has now. An empty value, as from a recipe variable that
    expanded to nothing, is not stated, and ``$NAME`` and ``~`` are expanded,
    as `process.merge_options` and `batch_io.run_path` expand them, so that
    the folders a run logs to are the ones its command works in.
    """
    stated = {}
    for tier in tiers:
        for key, value in _canonical(tier).items():
            if key in stated or key not in PLACEMENT_PARAMETERS:
                continue
            if not isinstance(value, str) or not value.strip():
                continue
            stated[key] = os.path.expanduser(os.path.expandvars(value.strip()))
    return stated


def _absolute(path, base):
    """`path` made absolute against `base`, and normalised."""
    return os.path.normpath(os.path.join(base, path))


def run_study(stated, cwd=None):
    """
    ``run_study(stated, cwd=None)``

    The study a run is in, and whether it is known. The study is known when
    the run names it, or names a sessions folder, which is in its study.
    Otherwise it is the study marked by `.qunexstudy` at or above the first of
    `STUDY_HINTS` the run states that is in one, else at or above the current
    folder; else there is none and the run is outside a study. Takes what
    `placement_parameters` returns.
    """
    cwd = os.path.abspath(cwd or os.getcwd())

    if stated.get("studyfolder"):
        return _absolute(stated["studyfolder"], cwd), True
    if stated.get("sessionsfolder"):
        return os.path.dirname(_absolute(stated["sessionsfolder"], cwd)), True

    for hint in STUDY_HINTS:
        value = stated.get(hint)
        if value and value != LEGACY:
            study = find_study(_absolute(value, cwd))
            if study:
                return study, False

    return find_study(cwd), False


def study_exists(folder):
    """
    ``study_exists(folder)``

    Whether the study ``folder`` exists: a folder holding something other than
    QuNex's logs. A run's logs are written into the study it names before the
    command runs, so a folder holding nothing but those logs -- ``logs``, or
    ``processing`` with nothing but ``logs`` in it -- is a study that does not
    exist yet. A second run, a job the run submitted, and a recipe's external
    step then decide as the first run did.
    """
    if not folder:
        return False
    try:
        entries = set(os.listdir(folder)) - {LOGS}
    except OSError:
        return False
    if entries != {PROCESSING}:
        return bool(entries)
    try:
        return bool(set(os.listdir(os.path.join(folder, PROCESSING))) - {LOGS})
    except OSError:
        # a `processing` that can not be listed is not one the logs made
        return True


def path_base(study, known, creating=False):
    """
    ``path_base(study, known, creating=False)``

    The folder a run takes its relative paths from: the study it knows -- the
    one it names, or the one a sessions folder it names is in -- once that
    study exists (:func:`study_exists`), unless the run's command creates it.
    None means the current folder, which is where a run that names neither
    folder takes them from, even inside a study its marker shows.
    """
    if study and known and not creating and study_exists(study):
        return study
    return None


def outside_folder(outside_study="home", cwd=None, home=None):
    """
    ``outside_folder(outside_study="home", cwd=None, home=None)``

    The folder the runs outside any study log in, by the ``outside_study``
    setting: ``home`` is ``~/qunex_logs``, ``cwd`` the current folder, and
    anything else a path -- taken against the current folder when it is
    relative, there being no study to take it against.
    """
    cwd = os.path.abspath(cwd or os.getcwd())

    if not outside_study or outside_study == "home":
        return os.path.join(home or os.path.expanduser("~"), OUTSIDE_STUDY_LOGS)
    if outside_study == "cwd":
        return cwd
    if home and (outside_study == "~" or outside_study.startswith("~/")):
        outside_study = home + outside_study[1:]
    return _absolute(os.path.expanduser(outside_study), cwd)


def log_folder(
    name,
    timestamp,
    stated,
    study,
    known,
    layout="default",
    outside_study="home",
    cwd=None,
    home=None,
    creating=False,
):
    """
    ``log_folder(name, timestamp, stated, study, known, layout="default", outside_study="home", cwd=None, home=None, creating=False)``

    The folder a run logs in. A ``logfolder`` the run states is that folder;
    a relative one is taken from the folder the run takes every relative path
    from -- :func:`path_base`, else the current folder. Otherwise the run gets
    a folder of its own, ``<timestamp>_<name>``: in the study's ``logs``
    folder, or -- under ``--logfolder=legacy`` or ``layout: legacy`` -- the
    study's ``processing/logs``, which every run of the study shares. A run
    outside a study gets its folder in the ``outside_study`` folder, whatever
    the layout: there is no study to collect it in.
    """
    named = (stated or {}).get("logfolder")
    if named and named != LEGACY:
        base = path_base(study, known, creating)
        return _absolute(named, base or os.path.abspath(cwd or os.getcwd()))

    if study:
        if named == LEGACY or layout == LEGACY:
            return os.path.join(study, LEGACY_LOGS)
        return os.path.join(study, LOGS, "%s_%s" % (timestamp, name))

    return os.path.join(
        outside_folder(outside_study, cwd, home), "%s_%s" % (timestamp, name)
    )


def user_settings_files(home=None):
    """The user settings files that exist, of the places one is accepted in."""
    home = home or os.path.expanduser("~")
    paths = [os.path.join(home, path[2:]) for path in USER_SETTINGS_PATHS]
    return [path for path in paths if os.path.isfile(path)]


def placement_settings(*sections):
    """
    ``placement_settings(*sections)``

    The ``layout`` and ``outside_study`` the ``logging:`` sections of the
    settings files state, each later section overriding the earlier ones key
    by key -- the user's first, then the study's. Raises PlacementError on a
    section that is not a mapping, and on a value QuNex does not take.
    """
    merged = {}
    for section in sections:
        if section and not isinstance(section, dict):
            raise PlacementError(
                "logging must be a mapping of settings, got: %r" % (section,)
            )
        merged.update(section or {})

    layout = merged.get("layout", "default")
    outside_study = merged.get("outside_study", "home")
    if layout not in LAYOUTS:
        raise PlacementError(
            "logging.layout must be one of [%s], got: %r" % (", ".join(LAYOUTS), layout)
        )
    if not isinstance(outside_study, str):
        raise PlacementError(
            "logging.outside_study must be one of [%s] or a path, got: %r"
            % (", ".join(OUTSIDE_STUDY), outside_study)
        )
    return LogPlacement(layout, outside_study)


def run_folders(
    name, tiers, timestamp, settings=None, cwd=None, home=None, creating=False
):
    """
    ``run_folders(name, tiers, timestamp, settings=None, cwd=None, home=None, creating=False)``

    Where a QuNex run is, where it takes its relative paths from, and where it
    logs: the one rule every entry point follows -- `gmri` for every command
    it runs, `run_recipe` called on its own, `qunex_container` on the host
    through its copy of this module, and `bin/qunex.sh` through
    `gmri log_folder`.

    Parameters:
        name: what the run is filed under, from :func:`run_name`.
        tiers: the dictionaries that state the run's parameters, highest
            first: the command line, the recipe file's run wide parameters
            for `run_recipe`, the batch file header.
        timestamp: the run's stamp, as :data:`TIMESTAMP` formats it.
        settings: a callable given the study (or None) that returns the
            resolved logging settings -- anything with ``layout`` and
            ``outside_study`` -- or None for the defaults.
        cwd, home: the current and the home folder, for tests.
        creating: whether the run's command creates the study it names
            (``create_study``, ``manage_study``, ``copy_study``), and so takes
            no relative path from it.

    Returns:
        a :data:`Placement`.
    """
    stated = placement_parameters(*tiers)
    study, known = run_study(stated, cwd)
    base = path_base(study, known, creating)
    resolved = settings(study) if settings else LogPlacement("default", "home")
    logfolder = log_folder(
        name,
        timestamp,
        stated,
        study,
        known,
        resolved.layout,
        resolved.outside_study,
        cwd,
        home,
        creating,
    )
    return Placement(name, study, known, base, logfolder, resolved)


# --- END GENERATED ---


def _read_yaml(path, what, function="qunex_container"):
    """
    ``_read_yaml(path, what, function="qunex_container")``

    A YAML file the launcher reads to place a run -- a settings file or a
    recipe file, as `what` names it -- parsed, or None when there is no such
    file. Without PyYAML in the host python the file can not be read here: the
    launcher says so when the file states something that places a run, and
    goes on as if it stated nothing.

    Raises:
        CommandError: from `function`, when the file can not be read or parsed.
    """
    if not isinstance(path, str) or not os.path.isfile(path):
        return None

    try:
        with open(path, "r", encoding="UTF-8") as f:
            if yaml is not None:
                return yaml.safe_load(f)
            text = f.read()
    except (OSError, ValueError) as e:
        raise CommandError(function, f"Could not read {what}", path, str(e))
    except Exception as e:
        # PyYAML's own errors, which are not of either kind
        raise CommandError(function, f"Could not parse {what}", path, str(e))

    names = ("layout", "outside_study") + PLACEMENT_PARAMETERS + tuple(FOLDER_ALIASES)
    if re.search(r"^\s*(%s)\s*:" % "|".join(names), text, re.M):
        print(
            f"WARNING: The host python has no PyYAML, so qunex_container can not "
            f"read the {what} [{path}], and what it states about where the run's "
            f"files and logs are is not applied to this run. Install PyYAML for "
            f"the python that runs qunex_container, or name --studyfolder or "
            f"--logfolder on the command line."
        )
    return None


def host_settings(study):
    """
    ``host_settings(study)``

    The `layout` and `outside_study` a run is placed by, read as QuNex reads
    them (`general/log/settings.py`): from the user's settings file, which is
    in at most one of the places one is accepted in, and from the
    `qunex_settings.yaml` of `study` over it, key by key. `study` is None for
    a run outside one.

    Raises:
        CommandError: on more than one user settings file, on a file that
            does not hold a mapping, and on a setting QuNex does not take.
    """
    users = user_settings_files()
    if len(users) > 1:
        raise CommandError(
            "qunex settings",
            "More than one user settings file found",
            f"QuNex reads user settings from one file only, but found {len(users)}:",
            *[f"    {path}" for path in users],
            "Please keep the one you want and remove or rename the others.",
        )

    sections = []
    for path in users + ([os.path.join(study, STUDY_SETTINGS_FILE)] if study else []):
        content = _read_yaml(path, "settings file", "qunex settings")
        if content is None:
            continue
        if not isinstance(content, dict):
            raise CommandError(
                "qunex settings",
                "Invalid settings file",
                f"{path} does not hold a mapping of settings sections.",
            )
        section = content.get("logging")
        if section and not isinstance(section, dict):
            raise CommandError(
                "qunex settings",
                "Invalid logging setting",
                f"logging must be a mapping of settings, got: {section!r}",
                f"Please write the logging section of {path} as indented "
                "`key: value` lines under `logging:`.",
            )
        sections.append(section)

    try:
        return placement_settings(*sections)
    except PlacementError as e:
        raise CommandError("qunex settings", "Invalid logging setting", str(e))


def host_recipe_parameters(command, args, environ=None):
    """
    ``host_recipe_parameters(command, args, environ=None)``

    For run_recipe, what its recipe file states that places the run -- its
    tier of `run_folders`, as `recipe_placement` reads it -- with its labels
    injected from `environ`, the environment unless another is given. A label
    `environ` does not hold leaves its parameter out, and is said: the
    variable may be set inside the container in a way the host does not see.
    """
    if command != "run_recipe" or not isinstance(args.get("recipe_file"), str):
        return {}
    if not args.get("recipe"):
        return {}

    data = _read_yaml(args["recipe_file"], "recipe file")
    parameters, unresolved = recipe_placement(data, args["recipe"], environ)
    for key, message in unresolved:
        print(
            f"WARNING: {message} The recipe's {key} can not be resolved on the "
            f"host, so it does not place this run's logs. Export the variable in "
            f"--bash_post (export NAME=value) or name --studyfolder or "
            f"--logfolder on the command line."
        )

    return parameters


def host_anchor(command, cargs, environ=None):
    """
    ``host_anchor(command, cargs, environ=None)``

    The command line, with what it names that is read before the run knows
    every study it may name made absolute as QuNex makes it absolute
    (`general/placement.py`'s `anchor`): the study from the current folder,
    and the batch file, a `.list` of sessions and the recipe file from the
    study the command line names, else from the current folder. A deprecated
    name of a folder counts as the name it has now.

    For run_recipe the recipe file is read here, once for the run, its labels
    injected from `environ` (`host_recipe_parameters`). When the command line
    names no study, the study the recipe names is the one the batch file and
    a list of sessions are found in, as QuNex finds them there; a sessions
    folder it names without a study is taken from that study.

    Returns:
        ``(anchored, recipe, recipe_named, study)``: the anchored arguments;
        the recipe file's tier of `run_folders`, empty for every other
        command; the study and the sessions folder the recipe names, settled
        absolute, when they stand in for a command line that names neither,
        else empty; and the study the files read early were taken from, None
        for the current folder.

    Raises:
        CommandError: when the recipe file can not be read or parsed.
    """
    cargs = _canonical(cargs)
    anchored, study = anchor_command_line(cargs, command)
    recipe = host_recipe_parameters(command, anchored, environ)

    named = {
        key: recipe[key]
        for key in ("studyfolder", "sessionsfolder")
        if isinstance(recipe.get(key), str) and recipe[key].strip()
    }
    if study is not None or not named:
        # a sessions folder named without a study, from the study the recipe
        # names, as QuNex takes it (`placement._sessions_in_recipe_study`)
        sessions = anchored.get("sessionsfolder")
        if (
            isinstance(sessions, str)
            and sessions.strip()
            and not str(anchored.get("studyfolder") or "").strip()
            and "studyfolder" in named
        ):
            anchored["sessionsfolder"] = run_path(
                sessions, run_path(named["studyfolder"])
            )
        return anchored, recipe, {}, study

    # settled as QuNex settles what a recipe names: the study from the current
    # folder, and a sessions folder from that study
    if "studyfolder" in named:
        named["studyfolder"] = run_path(named["studyfolder"])
    if "sessionsfolder" in named:
        named["sessionsfolder"] = run_path(
            named["sessionsfolder"], named.get("studyfolder")
        )
    study = study_folder(named.get("studyfolder"), named.get("sessionsfolder"))

    anchored, _ = anchor_command_line(
        {**cargs, "recipe_file": anchored["recipe_file"]}, command, study=study
    )
    return anchored, recipe, named, study


def host_placement(command, cargs, header, timestamp, bash_post=None, recipe=None):
    """
    ``host_placement(command, cargs, header, timestamp, bash_post=None, recipe=None)``

    Where this run is and where it logs, decided on the host before the
    container starts: by the rule QuNex places every run by (`run_folders`,
    spliced above from general/folders.py), from the tiers QuNex reads -- the
    command line, the recipe file of a run_recipe run and the batch file
    header, in that order -- and from the settings files (`host_settings`).
    The header is taken less what the run unsets from it, as QuNex takes it.

    `recipe` is the recipe file's tier `host_anchor` read; when it is not
    given the recipe file is read here, its labels injected from the
    environment and from what `bash_post` exports. The launcher keeps its own
    files in the log folder, and hands the folder to the command in the
    container with --logfolder, so that all of a run's logs are in one folder.

    Returns:
        the `Placement`.

    Raises:
        CommandError: when the settings files or the recipe file can not be
            used.
    """
    patterns = unset_patterns(cargs.get(UNSET_BATCH_HEADER))
    header, _ = without_unset(header or {}, patterns)
    header, _ = without_unset(_canonical(header), patterns)

    if recipe is None:
        environ = {**os.environ, **bash_post_exports(bash_post)}
        recipe = host_recipe_parameters(command, cargs, environ)

    return run_folders(
        run_name(command, cargs),
        [cargs, recipe, header],
        timestamp,
        settings=host_settings,
        creating=command in CREATES_STUDY,
    )


def expand_session_globs(sessions, sessionsfolder):
    """
    ``expand_session_globs(sessions, sessionsfolder)``

    The sessions a run without a batch file names, with every glob among them
    (`*`, `?`, `[...]`) expanded into what it matches in `sessionsfolder`. A
    plain id is kept as it is given, and so is a glob that matches nothing: an
    import names sessions whose folders do not exist yet. A `*.list` file is
    returned as it is, as it is read rather than matched.
    """
    if not sessions or not sessionsfolder or LIST_FILE.match(sessions):
        return sessions

    ids = []
    for e in _split_sessions(sessions):
        matched = []
        if re.search(r"[*?[]", e):
            matched = sorted(
                os.path.basename(m) for m in glob.glob(os.path.join(sessionsfolder, e))
            )
        ids += matched or [e]

    return ",".join(ids)


def anchored_binds(bind, docker=False):
    """
    ``anchored_binds(bind, docker=False)``

    What --bind names, `<source>[:<destination>[:<options>]]` separated by
    commas, with each relative source taken from the folder the launcher is
    run from, as its other options are: a scheduled job does not start there
    on every scheduler, PBS and GridEngine start it in the home folder. For
    Docker a source that is a bare name is a volume, not a folder, and is left
    as it is.
    """
    if not isinstance(bind, str) or not bind.strip():
        return bind

    binds = []
    for spec in bind.split(","):
        source, colon, rest = spec.partition(":")
        source = source.strip()
        folder = not docker or source.startswith((".", "~")) or "/" in source
        if source and folder and (source.startswith("~") or not os.path.isabs(source)):
            source = run_path(source)
        binds.append(source + colon + rest)
    return ",".join(binds)


def write_status_record(path, command, timestamp, stati):
    """
    ``write_status_record(path, command, timestamp, stati)``

    Writes the status record `--logstatus` asks for, in the shape QuNex
    writes it (`RunContext.write_status`), for a call whose jobs are
    submitted: they are not handed the path, as each would write the same
    file and the last to finish would overwrite the others. `stati` are
    `(session, summary, failed)` triples, `failed` None for a job whose
    outcome is not known here. Without PyYAML it is written as JSON, which
    YAML reads.
    """
    failed = [f for _, _, f in stati]
    record = {
        "command": command,
        "timestamp": timestamp,
        "runlog": None,
        "failed": None if None in failed else sum(failed),
        "sessions": [
            {"id": sid, "summary": summary, "failed": f} for sid, summary, f in stati
        ],
    }
    folder = os.path.dirname(path)
    if folder:
        os.makedirs(folder, exist_ok=True)
    with open(path, "w", encoding="UTF-8") as f:
        if yaml is not None:
            yaml.safe_dump(record, f, sort_keys=False, default_flow_style=False)
        else:
            json.dump(record, f, indent=2)


def main(args=None):
    """
    qunex_container is a self-standing command that can run QuNex commands
    within a Singularity/Apptainer or a Docker QuNex container. To run a QuNex
    command within a container the basic call is:

        qunex_container <qunex command>
        [parameters]
        --container="<path or name of the container image>"

    `<qunex command>` should be replaced by any command supported by QuNex.
    `parameters` are the specific command's parameters.

    For a list of commands and their parameters consult QuNex online or in-line
    documentation. Or run

    qunex_container --allcommands
        --container="<path or name of the container image>"

    Additionally qunex_container accepts the following parameters:

    INPUTS
    ======

    --container         specifies either the path to the Singularity/Apptainer
                        container image or the full specification of the Docker
                        container to be used (e.g. qunex/qunex_suite:0_45_07).
    --bash_pre          If any additional commands have to be run in bash before the
                        execution of qunex_container command itself. Use a semicolon
                        separated list to chain multiple commands. ['']
    --bash_post         Used if any additional commands have to be run inside the
                        QuNex container before executing the desired QuNex command.
                        Use a semicolon separated list to chain multiple commands.
                        ['']
    --bind              Used for binding external folders in order for the system in
                        the container to have access to relevant data. Maps to -B
                        parameter of Singularity/Apptainer and -v parameter of
                        Docker. A relative folder is taken from the folder
                        qunex_container is run from.
    --nocleanenv        By default QuNex will use the --cleanenv flag of
                        Singularity/Apptainer so your local environment setup will
                        not be propagated into the container. If you want to disable
                        this functionality use this flag. The flag is not set by
                        default.
    --cuda              Use in order to prepare the container for CUDA usage. This
                        flag is not set by default.
    --cuda_path         Can be used to bind a local CUDA version over the one in the
                        system.
    --nv                An old way of using CUDA inside Singularity/Apptainer.
                        If provided then --nv option will be used when executing.
    --script            If a script is to be run against the Singularity/Apptainer
                        container rather than a single command, the path to the
                        script to be run is specified here. The run is filed
                        under the script's name. ['']
    --containeropt      A string that lists the additional options to be used when
                        running the container. The parameters are to be specified in
                        a string exactly as they would be on a command line, e.g.
                        to run Docker in detached mode and mount a specific folder
                        use::

                            "-d -v /host/directory:/container/directory"
    --scheduler         A string that specifies the details to use to submit the
                        container job to a scheduling system.
    --console_out       Where the scheduler writes the output of each job, as
                        "<key>:<file>" pairs separated by pipes: stdout, stderr
                        or both (the two together). A file named without a
                        folder is in the current one. By default each job writes
                        both to a file of its own in the batchlogs folder of the
                        run's log folder (see RESULTS).
    --scheduling_delay  A string that specifies the delay to use when scheduling
                        the container job. This can be useful to avoid overloading
                        the scheduling system.
    --parjobs           Specify the maximum amount of jobs that will be created
                        and run in parallel. By default this equals the number
                        of sessions you provided.
    --parsessions       Specify the amount of sessions that will be run in parallel
                        inside each created job. [1]
    --parelements       Specify the amount of elements that will be run in parallel
                        inside each session (for example BOLDs in hcp_fmri_volume).
                        [1]
    --parinfo           If this flag is set then qunex_container will not execute
                        the command, it will only printout the parallelism
                        information, e.g. how many jobs will be spawned, how many
                        sessions will be run in parallel, etc.
    --interactive       Start the container in interactive mode. When this flag
                        is set, instead of running a specific command, an
                        interactive shell will be started inside the container
                        with the QuNex environment already configured. All
                        relevant parameters (--bind, --cuda, --bash_pre,
                        --bash_post, --nocleanenv, --cuda_path, --nv,
                        --containeropt) will be applied.
    --logfolder         The folder the run logs in. When it is not given, it is
                        the one QuNex decides on:
                        <study>/logs/<date>_<time>_<command> for the study the
                        run names (on the command line, in the recipe file of
                        run_recipe or in the batch file header), else for the
                        study marked by .qunexstudy at or above the current
                        folder; for a run outside a study, a folder of its own
                        in ~/qunex_logs, or where the outside_study setting
                        says. "legacy" is <study>/processing/logs. A relative
                        path is taken from the run's study when the run names
                        it (or a sessions folder in it), the study exists and
                        the command does not create it; else from the current
                        folder. The folder is decided here, on the host, and
                        handed to every job.

    Selecting sessions
    ------------------

    `--batchfile`, `--sessions` and `--filter` are read by `qunex_container`
    to work out how many sessions the run has and how to spread them over
    jobs, and are then passed on to the command: `--batchfile` names the
    batch file, `--sessions` selects within it by id or glob pattern, and
    `--filter` selects by a `<key>:<value>` pair of the session's batch file
    entry. They are resolved by the same code the suite itself uses, so the
    sessions a job is sized for are the sessions the command runs over.

    Relative paths
    --------------

    `qunex_container` takes relative paths as QuNex does. The study folder is
    taken from the folder `qunex_container` is run from. The batch file, a
    `.list` file given to `--sessions` and the recipe file are taken from the
    study the command line names (or the folder a `--sessionsfolder` it names
    is in; for run_recipe also the study the recipe names), else from the
    folder `qunex_container` is run from. They are handed to the command
    absolute, as are the study folder and a sessions folder named with it.

    The command starts in the folder `qunex_container` was run from, and takes
    every other relative path from there as QuNex does: from the study, once
    the study exists. The container has to see that folder, which it does
    when it is in your home folder or bound with `--bind`; when it does not,
    a warning names the folder the command starts in instead. `--container`,
    `--script`, `--bind` and `--cuda_path` are `qunex_container`'s own, and
    are taken from the folder it is run from.

    RESULTS
    =======

    `qunex_container` decides the run's log folder before anything runs,
    prints it as `---> Logs: <folder>`, and hands it to the command in the
    container with `--logfolder`, so that all the logs of the run are in one
    folder. A `--script` run has no command to hand it to: each QuNex command
    the script runs logs in a folder of its own, unless the script gives it a
    `--logfolder`. `qunex_container`'s own files are in the folder's
    `batchlogs`: the script each job runs in the container
    (`qunex_container_command_<date>_<time>_<job>.sh`)
    and, with `--scheduler`, the script submitted for each job and the job's
    output, its standard output and error together
    (`<scheduler>_<command>[_job<NN>].<date>_<time>.sh` and `.log`). The log
    folder has to be visible inside the container: your home folder always
    is, a study elsewhere through `--bind`.

    The log folder is decided by the rule QuNex places every run by, so it
    reads the batch file header, the recipe file of run_recipe and the
    `qunex_settings.yaml` settings files. It reads the YAML files with
    PyYAML; when the host python has none, it says which file it could not
    read and places the run without it. A recipe's `{{$VAR}}` labels are
    resolved from the environment `qunex_container` runs in and from the
    `export NAME=VALUE` statements of `--bash_post`; a label it can not
    resolve is said, and does not place the run.

    If a script parameter is specified, in case of a Singularity/Apptainer
    container, the script will be executed using the `bash <script>` command.
    In case of a Docker container, the content of the script will be appended
    to the temporary script generated by the `qunex_container`.

    Scheduling jobs
    ---------------

    Container commands can be submitted to a scheduling system by specifying
    the `--scheduler` parameter with a settings string. The settings string
    should be a comma separated list of parameters. The first parameter has to
    be the scheduler name (PBS, SLURM or GridEngine), the rest of the parameters
    are key-value pairs that are to be passed as settings to the scheduler.

    Example settings strings::

        "SLURM,jobname=hcp_fs,time=24:00:00,cpus-per-task=2,mem-per-cpu=16GB"

    Scheduling multiple jobs in parallel
    ------------------------------------

    If the parameters provided include --parjobs, --parsessions, --scheduler
    and --sessions or --batchfile, then qunex_container will spread the execution
    of the command by scheduling multiple jobs to run on separate nodes. Specifically,
    if --parjobs is not provided then QuNex will schedule a job for each of the
    sessions. If --parjobs is provided then QuNex will schedule at most the
    requested amount of jobs, inside each job QuNex will run at most
    --parsessions in parallel.  E.g. if 10 sessions are specified, parjobs
    is set to 3 and parsessions is set to 4, QuNex will schedule 3 jobs. The first
    job will run 4 sessions in parallel and the other 2 jobs will run 3 sessions
    in parallel.

    EXAMPLE USE
    ===========

    Running a QuNex command in a container::

        qunex_container hcp_freesurfer \\
            --studyfolder=/data/study \\
            --batchfile=/data/study/processing/batch.txt \\
            --parsessions=4 \\
            --container=/apptainer/qunex_suite-0_38_10.sif \\
            --scheduler="SLURM,time=2-00:00:00,cpus-per-task=2,mem-per-cpu=15000,partition=week"

    Starting an interactive session in a container::

        qunex_container --interactive \\
            --container=/apptainer/qunex_suite-0_38_10.sif \\
            --bind=/data:/data

    Starting an interactive session with CUDA support::

        qunex_container --interactive \\
            --container=/apptainer/qunex_suite-0_38_10.sif \\
            --bind=/data:/data \\
            --cuda
    """

    if args is None:
        args = sys.argv[1:]

    if not args or args[0] in ["-h", "--help"]:
        print(main.__doc__)
        exit()

    # deprecation warnings
    for arg in args:
        if "sessionids=" in arg:
            print(
                "WARNING: The sessionids parameter will be deprecated, use the sessions parameter to select sessions."
            )
        if "sessions=" in arg and ".txt" in arg:
            print(
                "WARNING: It seems like you are using the sessions parameters to pass the location of the batch file to QuNex. This functionality will be deprecated, use the batchfile parameter for specifying the location of the batchfile."
            )

    # what the command line states, read as QuNex reads a command line, and
    # what it names that is read before the command runs made absolute here,
    # on the host, as QuNex makes it absolute (`host_anchor`): the study from
    # the current folder, and the batch file, a list of sessions and the
    # recipe file from the study the command line names -- for run_recipe,
    # else the one its recipe names. The command inside is handed them so,
    # and finds them whatever folder the container or a scheduled job starts in
    cargs, first = {}, None
    for arg in args:
        if arg.startswith("--"):
            key, eq, value = arg[2:].partition("=")
            cargs[key] = value if eq else True
        elif first is None:
            first = arg

    environ = {**os.environ, **bash_post_exports(cargs.get("bash_post"))}
    try:
        anchored, recipe, recipe_named, named_study = host_anchor(first, cargs, environ)
    except CommandError as e:
        print(f"\nERROR: {e.error}\n" + "\n".join(str(h) for h in e.hints))
        exit(1)

    # the folder this was started from: the command inside works there, as it
    # would outside the container, when the container can see it
    try:
        invoked_from = os.getcwd()
    except OSError:
        invoked_from = None

    env_status = False
    scheduler = None
    container = None
    command = ""
    bash_pre = None
    bash_post = None
    bind = None
    nocleanenv = None
    cuda = None
    nv = None
    cuda_path = None
    script = None
    parjobs = None
    parsessions = None
    parelements = 1
    batchfile = None
    batchfilter = None
    sessions = None
    sessionsfolder = None
    studyfolder = None
    sessionids = None
    containeropt = ""
    output = None
    parinfo = None
    overwrite = None
    scheduling_delay = 0
    interactive = False
    logstatus = None

    for arg in args:
        # cleanup -- at start
        if arg.startswith("--"):
            arg = arg[2:]

            if arg == "env_status" or arg == "envstatus":
                env_status = True
            if arg.startswith("scheduler="):
                k, scheduler = arg.split("=", 1)
            elif arg.startswith("container="):
                k, container = arg.split("=", 1)
                # an image file, absolute so that a scheduled job finds it
                if container.endswith((".sif", ".simg")):
                    container = run_path(container)
            elif arg.startswith("containeropt="):
                k, containeropt = arg.split("=", 1)
            elif arg.startswith("console_out="):
                k, output = arg.split("=", 1)
            elif arg.startswith("bash_pre="):
                k, bash_pre = arg.split("=", 1)
            elif arg.startswith("bash_post="):
                k, bash_post = arg.split("=", 1)
            elif arg.startswith("bind="):
                k, bind = arg.split("=", 1)
            elif arg.startswith("cuda_path="):
                k, cuda_path = arg.split("=", 1)
                # bound into the container, from wherever a scheduled job starts
                cuda_path = run_path(cuda_path)
            elif arg.startswith("script="):
                k, script = arg.split("=", 1)
                # the launcher's own, taken from where it is run
                script = run_path(script)
            elif arg.startswith("parjobs="):
                k, parjobs = arg.split("=", 1)
                parjobs = int(parjobs)
            elif arg.startswith("parsessions="):
                k, parsessions = arg.split("=", 1)
                command += f'--{k}="{parsessions}" '
                parsessions = int(parsessions)
            elif arg.startswith("parelements="):
                k, parelements = arg.split("=", 1)
                command += f'--{k}="{parelements}" '
                parelements = int(parelements)
            elif arg.startswith("sessionsfolder="):
                k, sessionsfolder = arg.split("=", 1)
                sessionsfolder = anchored.get(k, sessionsfolder)
                command += f'--{k}="{sessionsfolder}" '
            elif arg.startswith("studyfolder="):
                k, studyfolder = arg.split("=", 1)
                studyfolder = anchored.get(k, studyfolder)
                command += f'--{k}="{studyfolder}" '
            elif arg.startswith("sessions="):
                k, sessions = arg.split("=", 1)
                sessions = anchored.get(k, sessions)
            elif arg.startswith("batchfile="):
                k, batchfile = arg.split("=", 1)
                batchfile = anchored.get(k, batchfile)
            elif arg.startswith("filter="):
                k, batchfilter = arg.split("=", 1)
            elif arg.startswith("sessionids="):
                k, sessionids = arg.split("=", 1)
            elif arg.startswith("logfolder="):
                # not passed on as it is given: the run's log folder is decided
                # below, from this as well, and handed to the command once
                pass
            elif arg.startswith("overwrite="):
                overwrite = arg.split("=", 1)
                overwrite = overwrite[1]
                command += f"--overwrite={overwrite} "
            elif arg == "overwrite":
                overwrite = "yes"
                command += "--overwrite "
            elif arg == "nocleanenv":
                nocleanenv = True
            elif arg == "cuda":
                cuda = True
            elif arg == "nv":
                nv = True
            elif arg == "parinfo":
                parinfo = True
            elif arg == "interactive":
                interactive = True
            elif arg.startswith("scheduling_delay="):
                k, scheduling_delay = arg.split("=", 1)
                scheduling_delay = int(scheduling_delay)
            elif arg.startswith("logstatus="):
                # a status file, as it was anchored: handed to a job that runs
                # here, written here for jobs that are submitted
                k, logstatus = arg.split("=", 1)
                logstatus = anchored.get(k, logstatus)
            elif "=" in arg:
                k, v = arg.split("=", 1)
                # the recipe file, as it was anchored
                if k in READ_EARLY:
                    v = anchored.get(k, v)
                command += f'--{k}="{v}" '
            else:
                command += f"--{arg} "

        else:
            command += f"{arg} "

    fail = False

    # timestamp
    timestamp = datetime.now().strftime(TIMESTAMP)

    if interactive and env_status:
        print("ERROR: Cannot use interactive mode with env_status!")
        fail = True

    if interactive and scheduler is not None:
        print("ERROR: Cannot use interactive mode with scheduler!")
        fail = True

    if interactive and bash_post is not None:
        print("ERROR: Cannot use interactive mode with bash_post!")
        fail = True

    if interactive and bash_pre is not None:
        print("ERROR: Cannot use interactive mode with bash_pre!")
        fail = True

    if fail:
        exit(1)

    # parsessions
    if parsessions is None:
        parsessions = 1

    # workaround for commands that are not supported
    commands_blacklist = [
        "create_batch",
        "create_list",
        "create_conc",
        "gather_behavior",
        "pull_sequence_names",
        "create_stats_report",
        "fc_compute_roifc",
        "fc_compute_gbc",
        "fc_compute_seedmaps",
        "fc_extract_roi_timeseries",
        "general_extract_roi_values",
        "general_extract_roi_glm_values",
        "run_qa",
    ]
    qx_command = command.split(" ")[0]
    # ban parallel execution of these commands
    if (
        (overwrite == "yes" or overwrite is True)
        and parsessions > 1
        and qx_command in commands_blacklist
    ):
        print(
            "ERROR: Parallel execution of this command is not supported when overwrite is set!"
        )
        exit(1)

    homedir = os.path.expanduser("~")

    if container is None:
        print(
            "ERROR: No Singularity/Apptainer image or Docker container name specified through the --container parameter!"
        )
        exit(1)

    # Docker or Apptainer
    apptainer = container.endswith(".simg") or container.endswith(".sif")

    # the folders the container sees, from where this runs, as a job may start
    # anywhere
    bind = anchored_binds(bind, docker=not apptainer)

    # just report env status and quit
    if env_status:
        # apptainer
        if apptainer:
            env_command = f"singularity exec {container} bash /opt/qunex/env/qunex_container_env_status.sh"

        # docker
        else:
            env_command = f'docker run {container} bash -c "/opt/qunex/env/qunex_container_env_status.sh"'

        # run
        subprocess.run(env_command, shell=True, check=False)
        exit(0)

    # interactive mode
    if interactive:
        print("\n---> Starting QuNex container in interactive mode...\n")

        # binds
        if bind is None:
            container_bind = f"{homedir}:{homedir}"
        else:
            container_bind = f"{homedir}:{homedir},{bind}"

        # bind cuda path if provided
        if cuda_path:
            container_bind += f",{cuda_path}:/usr/local/cuda"

        if apptainer:
            container_command = []
            container_command += ["singularity", "exec"]
            container_command += ["--bind", container_bind]

            if containeropt:
                container_command += shlex.split(containeropt)

            # no clean env
            if nocleanenv is None:
                container_command.append("--cleanenv")

            # cuda
            if cuda:
                container_command += ["--nvccli", "-u"]

            # nv
            if nv:
                container_command += ["--nv"]

            container_command += [container.strip(), "bash", "-c"]

            # prepare startup script

            bash_script = "source /opt/qunex/env/qunex_environment.sh\n"
            bash_script += 'echo ""\n'
            bash_script += 'echo "QuNex environment loaded. You are now in an interactive QuNex container."\n'
            bash_script += 'echo ""\n'
            bash_script += 'export PS1="($(basename $CONDA_DEFAULT_ENV)) \\[\\e[0;36m\\][QuNex Container \\w]\\$\\[\\e[0m\\] "\n'
            bash_script += "exec bash\n"

            print(f"Executing: {' '.join(container_command)}\n")

            container_command.append(bash_script)
            subprocess.run(container_command)

        else:
            container_command = ["docker", "run", "-it"]

            bind_list = container_bind.split(",")
            for b in bind_list:
                container_command += ["-v", b]

            # containeropt
            if containeropt:
                container_command += shlex.split(containeropt)

            # cuda
            if cuda:
                container_command += ["--gpus", "all"]

            container_command += [container.strip()]

            print(f"Executing: {' '.join(container_command)}\n")
            subprocess.run(container_command)

        exit(0)

    if command.startswith("?scheduler"):
        print(schedule.__doc__)
        exit()

    # normalise the legacy encoding onto --batchfile / --sessions, the same
    # conversion gcs.normalize_session_parameters does inside the container
    if sessions is not None and ".txt" in sessions:
        if batchfile is not None:
            print(
                "ERROR: It seems like you passed the batchfile both through the sessions and the batchfile parameters!"
            )
            exit(1)
        # a batch file, found where QuNex would find it
        batchfile = run_path(sessions, named_study)
        sessions = sessionids
        sessionids = None
    elif sessions is not None and sessionids is not None:
        print(
            "WARNING: It seems like you are passing a list of sessions both through the sessions parameter and through the sessionids parameter!"
        )
    elif sessions is None and sessionids is not None:
        sessions = sessionids
        sessionids = None

    # number of sessions
    n_sessions = None

    # get sessionsids: with no batch file the sessions are the ones named, and
    # only a glob among them is matched against the session folders -- of the
    # sessions folder the command line names, under any of its names, else of
    # the study it names, else of the folders run_recipe's recipe names, as
    # QuNex matches them. An import names sessions that do not exist yet, and
    # its `--sessions` can be a list of patterns over the inbox, so nothing it
    # names is matched
    folders = recipe_named or anchored
    glob_folder = sessions_folder(
        *[
            value if isinstance(value, str) and value.strip() else None
            for value in (folders.get("studyfolder"), folders.get("sessionsfolder"))
        ],
        default=None,
    )
    if qx_command.startswith("import_"):
        glob_folder = None

    try:
        slist, header = resolve(
            batchfile=batchfile,
            sessions=(
                sessions if batchfile else expand_session_globs(sessions, glob_folder)
            ),
            filter=batchfilter,
            sessionsfolder=glob_folder if batchfile else None,
        )
    except BatchError as e:
        print(f"\nERROR: {e}\n")
        exit(1)

    g_sessionids = [e["id"] for e in slist] or None
    if g_sessionids:
        n_sessions = len(g_sessionids)

    # do not run in parallel multi_session/longitudinal commands
    multi_session_command = False
    multi_commands = [
        "hcp_prep_long",
        "hcp_long_freesurfer",
        "hcp_long_post_freesurfer",
        "hcp_long_msmall",
        "hcp_temporal_ica",
        "hcp_make_average_dataset",
        "fsl_melodic",
        "hcp_long_transmit_bias",
        "hcp_transmit_bias_group_average_fit",
        "hcp_transmit_bias_group_average_corrected_maps",
    ]
    if any(c in command for c in multi_commands):
        multi_session_command = True

    # are we using SLURM array, not by default
    slurm_array = False

    # init scheduler params
    if scheduler is not None:
        scheduler_params_list = [e.strip() for e in scheduler.split(",")]
        scheduler_name = scheduler_params_list.pop(0)

        # check scheduler
        if scheduler_name not in ["PBS", "SLURM", "GridEngine"]:
            raise CommandError(
                "schedule",
                "Misspecified parameter",
                "First value in the settings string has to specify one of PBS, SLURM or GridEngine!",
                "The settings string submitted was:",
                scheduler_name,
            )

        # parse scheduler parameters
        scheduler_params = {}
        # pass params as is for GridEngine
        if scheduler_name == "GridEngine":
            for s in scheduler_params_list:
                if s.startswith("jobname"):
                    str_split = s.split("=")
                    scheduler_params["N"] = str_split[1].strip()
                else:
                    str_split = s.split()
                    setting = str_split[0].strip()
                    value = " ".join(str_split[1:]).strip()
                    if setting in scheduler_params:
                        scheduler_params[setting] = [scheduler_params[setting], value]
                    else:
                        scheduler_params[str_split[0].strip()] = " ".join(
                            str_split[1:]
                        ).strip()
        else:
            for s in scheduler_params_list:
                # parameters with values
                if "=" in s:
                    str_split = s.split("=", 1)

                    # SLURM job array?
                    if scheduler_name == "SLURM" and str_split[0].strip() == "array":
                        slurm_array = True

                    scheduler_params[str_split[0].strip()] = str_split[1].strip()
                # flags
                else:
                    # SLURM job array?
                    if scheduler_name == "SLURM" and s.strip() == "array":
                        n_jobs = 1
                        if n_sessions is not None:
                            n_jobs = n_sessions - 1
                        slurm_array = True
                        if parjobs is None:
                            scheduler_params["array"] = f"0-{n_jobs}"
                        else:
                            scheduler_params["array"] = f"0-{n_jobs}%{parjobs}"
                    else:
                        scheduler_params[s.strip()] = None

        # if job array we have a single job
        if slurm_array:
            parjobs = 1

            # only allow HCP MPP commands with job array
            array_commands = [
                "hcp_pre_freesurfer",
                "hcp_freesurfer",
                "hcp_nhp_freesurfer",
                "hcp_post_freesurfer",
                "hcp_fmri_volume",
                "hcp_fmri_surface",
                "run_recipe",
            ]
            if qx_command not in array_commands:
                print(
                    "ERROR: SLURM job arrays are supported only for HCP Minimal Preprocessing Pipelines commands and run_recipe!"
                )
                print(
                    "         ... hcp_pre_freesurfer, hcp_freesurfer, hcp_post_freesurfer, hcp_fmri_volume, hcp_fmri_surface, run_recipe"
                )
                exit(1)

    # array for storing session ids
    sessionids_array = []

    # if scheduler is not None and we do not have a multi_session_command then setup parallelism
    if (
        scheduler is not None
        and g_sessionids
        and not multi_session_command
    ):
        # if parjobs is None each session is its own job
        if parjobs is None:
            parjobs = 0

            # split to chunks
            for i in range(0, n_sessions, parsessions):
                sessionids_array.append(",".join(g_sessionids[i : i + parsessions]))

            # calculate the number of parallel jobs
            parjobs = len(sessionids_array)

        # else split jobs into chunks
        else:
            # how big are chunks of sessions
            chunks = int(math.ceil(n_sessions / float(parsessions)))

            # if chunks is lower then parjobs tweak parjobs
            if chunks < parjobs:
                parjobs = chunks

            # init queues
            sessionids_arrays = [[] for _ in range(parjobs)]

            # divide sessions among jobs
            for idx, sessionid in enumerate(g_sessionids):
                job_id = idx % parjobs
                sessionids_arrays[job_id].append(sessionid)

            for s in sessionids_arrays:
                sessionids_array.append(",".join(s))

    else:
        # do not run in parallel
        parjobs = 1

        # add session ids
        if g_sessionids is not None:
            sessionids_array.append(",".join(g_sessionids))

    # print out details
    if scheduler:
        print(f"    Qunex will schedule {parjobs} jobs")

    if n_sessions is not None:
        print(
            f"\n---> QuNex will run the command over {n_sessions} sessions. It will utilize:\n"
        )
        print(f"    Maximum sessions run in parallel for a job: {parsessions}.")
        print(f"    Maximum elements run in parallel for a session: {parelements}.")
        print(
            f"    Up to {parelements * parsessions} processes will be utilized for a job.\n"
        )

        if slurm_array:
            print(f"    Using SLURM job array over sessions: {sessionids_array[0]}")
        else:
            for i in range(0, parjobs):
                print(f"    Job #{i + 1} will run sessions: {sessionids_array[i]}")

    # where the run logs: decided here, by the rule QuNex places every run by,
    # and handed to the command in the container, so that the launcher's job
    # scripts and the scheduler's output are in one folder with the command's
    # own logs. A call that runs nothing makes no folder
    if parinfo is None:
        # a run of a script rather than of a command is filed under the script
        if script:
            run_command = os.path.splitext(os.path.basename(script))[0]
        else:
            run_command = first
        try:
            placement = host_placement(
                run_command or "qunex_container",
                anchored,
                header,
                timestamp,
                recipe=recipe if run_command == first else {},
            )
        except CommandError as e:
            print(f"\nERROR: {e.error}\n" + "\n".join(str(h) for h in e.hints))
            exit(1)

        logfolder = placement.logfolder
        batchlogs = os.path.join(logfolder, "batchlogs")
        os.makedirs(batchlogs, exist_ok=True)
        print(f"\n---> Logs: {logfolder}\n", flush=True)

        # a job of several is numbered in what it leaves, as QuNex numbers the
        # jobs it submits itself
        jobs_over_sessions = bool(sessionids_array) and scheduler is not None
        stati = []

        # execute
        for i in range(0, parjobs):
            qx_command = command

            # add batchfile to command?
            if batchfile is not None:
                qx_command += f'--batchfile="{batchfile}" '

            # add sessions to command? Sessions that matched no folder go on
            # as they were given: an import names the sessions it is to create
            if i < len(sessionids_array):
                qx_command += f'--sessions="{sessionids_array[i]}" '
            elif sessions is not None and not sessionids_array:
                qx_command += f'--sessions="{sessions}" '

            # add filter to command?
            if batchfilter is not None:
                qx_command += f'--filter="{batchfilter}" '

            # the run's log folder, which the command logs in as it is
            qx_command += f'--logfolder="{logfolder}" '

            # the status record: the one job run here writes its own
            if logstatus and not scheduler:
                qx_command += f'--logstatus="{logstatus}" '

            # prepare the schedule file; one per job, as the scheduled job reads
            # it when it starts and every job here carries a different chunk of
            # the sessions
            script_path = os.path.join(
                batchlogs, f"qunex_container_command_{timestamp}_{i}.sh"
            )
            with open(script_path, "w", encoding="UTF-8") as f:
                print("source /opt/qunex/env/qunex_environment.sh", file=f)

                # the folder qunex_container was run from, so that the command
                # takes from there what it would take from there outside the
                # container -- Docker starts it in a folder of its own, a PBS
                # or GridEngine job in the home folder. Quoted for the shell in
                # the warning as well, where the double quotes are closed
                # around it: inside them a `"` in its name would end the string
                if invoked_from:
                    folder = shlex.quote(invoked_from)
                    print(
                        f'cd {folder} 2>/dev/null || echo "WARNING: "{folder}" is '
                        "not visible in the container, relative paths are taken "
                        'from $(pwd)" >&2',
                        file=f,
                    )

                if bash_post:
                    print(bash_post, file=f)

                if script:
                    if apptainer:
                        print("bash " + shlex.quote(script), file=f)
                    else:
                        # as it is: a line of a here document is text
                        with open(script, "r", encoding="UTF-8") as sfile:
                            text = sfile.read()
                        f.write(text if text.endswith("\n") else text + "\n")
                else:
                    print("bash /opt/qunex/bin/qunex.sh " + qx_command, file=f)

            # setup the container command
            container_command = ""
            if bash_pre:
                container_command += bash_pre + ";"

            if apptainer:
                container_command += "singularity exec "

                # binds
                if bind is None:
                    container_bind = f"{homedir}"
                else:
                    container_bind = f"{homedir},{bind}"

                # bind cuda path if provided
                if cuda_path:
                    container_bind = f"{container_bind},{cuda_path}:/usr/local/cuda/"

                # quoted, as are the image and the job script below: a path
                # made absolute carries the folder it was taken from, spaces
                # and all
                container_command += f"--bind {shlex.quote(container_bind)} "

                # containeropt
                if containeropt:
                    container_command += containeropt + " "

                # no clean env
                if nocleanenv is None:
                    container_command += "--cleanenv "
                    if slurm_array:
                        # the params we need are SLURM_ARRAY_TASK_ID and SLURM_ARRAY_TASK_MAX
                        # we do not need SLURM_JOB_ID, SLURM_ARRAY_JOB_ID, SLURM_ARRAY_TASK_COUNT, SLURM_ARRAY_TASK_MIN for now
                        slurm_array_params = [
                            "SLURM_ARRAY_TASK_ID",
                            "SLURM_ARRAY_TASK_MAX",
                        ]
                        # pass variables into the Singularity/Apptainer container
                        container_command += "--env "
                        container_command += ",".join(
                            [f"{p}=${p}" for p in slurm_array_params]
                        )
                        # add trailing space
                        container_command += " "

                # cuda
                if cuda:
                    container_command += "--nvccli -u "

                # nv
                if nv:
                    container_command += "--nv "

                container_command += (
                    f"{shlex.quote(container.strip())} bash {shlex.quote(script_path)}"
                )
            else:
                container_command += "docker run "

                # binds
                if bind is None:
                    container_bind = f"{homedir}:{homedir}"
                else:
                    container_bind = f"{homedir}:{homedir},{bind}"

                # bind cuda path if provided
                if cuda_path:
                    container_bind += f",{cuda_path}:/usr/local/cuda"

                bind_list = container_bind.split(",")
                for b in bind_list:
                    container_command += f"-v {shlex.quote(b)} "

                # containeropt
                if containeropt:
                    container_command += containeropt + " "

                # cuda
                if cuda:
                    container_command += "--gpus all "

                container_command += (
                    f"{shlex.quote(container.strip())} bash {shlex.quote(script_path)}"
                )

            if scheduler:
                # the job's output, both streams, named as QuNex names the
                # output of the jobs it submits, `<scheduler>_<run>[_jobNN]`,
                # and the script that was submitted beside it
                job = f"_job{i:02d}" if jobs_over_sessions and not slurm_array else ""
                stem = f"{scheduler_name}_{placement.name}{job}.{timestamp}"
                joblog = os.path.join(
                    batchlogs,
                    f"{scheduler_name}_{placement.name}"
                    f"{'_job%a' if slurm_array else job}.{timestamp}.log",
                )
                schedule(
                    command=container_command,
                    scheduler_name=scheduler_name,
                    scheduler_params=scheduler_params.copy(),
                    output=output or f"both:{joblog}",
                    parsessions=parsessions,
                    parelements=parelements,
                    script_path=os.path.join(batchlogs, f"{stem}.sh"),
                    # started from the launch folder, which Apptainer then
                    # binds, as a PBS or GridEngine job starts in the home one
                    workdir=invoked_from,
                )
                # the sessions of this job, or the run, in the status record
                job_sessions = (
                    sessionids_array[i].split(",")
                    if i < len(sessionids_array)
                    else [run_command or "qunex_container"]
                )
                stati += [
                    (sid, f"submitted (job {i:02d})", None) for sid in job_sessions
                ]
                # sleep here for scheduling_delay
                time.sleep(scheduling_delay)
            else:
                subprocess.run(container_command, shell=True, check=False)

        # the submitted jobs are not handed the status record: it is written here
        if logstatus and scheduler:
            write_status_record(
                logstatus, run_command or "qunex_container", timestamp, stati
            )


if __name__ == "__main__":
    main()
